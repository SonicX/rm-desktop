{
  "name": "RMConnect",
  "version": "5.27.3",
  "productName": "Связь РМ",
  "main": "./dist-electron",
  "description": "Приложение Связь РМ",
  "license": "Apache-2.0",
  "copyright": "Цифровые технологии РМ",
  "author": {
    "name": "Цифровые технологии РМ.",
    "email": "yuriy.tereschenko@yandex.ru"
  },
  "repository": {
    "type": "git",
    "url": "https://gitverse.ru/tsifrovye_tekhnologii_rm/rm-desktop.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "vite > log.txt 2>&1",
    "start-debug": "ELECTRON_ENABLE_LOGGING=1 vite 2>&1 | tee log.txt",
    "start-win": "set ELECTRON_ENABLE_LOGGING=1 && vite 2>&1 | tee log.txt",
    "build-only": "vite build && npm run copy-addon",
    "copy-addon": "cp native-addon/addon.node dist-electron/native-addon.node",
    "copy-native-addon": "cp native-addon/addon.node native/mac/native-addon.node",
    "copy-addon-for-win": "cp native-addon/win/capture.node dist-electron/native-addon.node",
    "build-and-run": "rimraf dist dist-electron && vite build && tsc -p tsconfig.json --skipLibCheck || echo 'TypeScript compilation errors ignored' && copy \"C:\\Users\\Admin\\Documents\\GitHub\\zulip-desktop\\native-addon\\capture.node\" \"dist-electron\\native-addon.node\" && electron dist-electron/index.js",
    "build-for-win": "vite build && npm run copy-addon-for-win",
    "rebuild": "electron-rebuild -f -w dist-electron/native-addon.node",
    "rebuild-dev": "electron-rebuild -f -w dist-electron/native-addon.node",
    "rebuild-native": "electron-rebuild --all",
    "dist-win": "npm run build-for-win && electron-builder --windows --config.win.target=nsis",
    "watch-ts": "tsc -w",
    "sign-mac-key-server": "node scripts/sign-mac-key-server.js",
    "reinstall": "rimraf node_modules && npm install",
    "postinstall": "electron-builder install-app-deps",
    "lint-css": "stylelint \"app/**/*.css\"",
    "lint-html": "htmlhint \"app/**/*.html\"",
    "lint-js": "xo",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "prettier-non-js": "prettier --check --log-level=warn . \"!**/*.{js,ts}\"",
    "test": "tsc && npm run lint-html && npm run lint-css && npm run lint-js && npm run prettier-non-js",
    "test-e2e": "vite build && tape \"tests/**/*.js\"",
    "pack": "vite build && electron-builder --mac pkg",
    "dist": "vite build && electron-builder --windows --config.win.target=nsis",
    "publish": "vite build && electron-builder --publish always",
    "mas": "vite build && electron-builder --windows --config.win.target=nsis",
    "store": "vite build && npm run copy-addon && electron-builder --mac --universal"
  },
  "pre-commit": [
    "test"
  ],
  "build": {
    "buildVersion": 18,
    "appId": "org.rm.rm-electron",
    "copyright": "©Цифровые технологии РМ",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "afterSign": "scripts/notarize.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitverse.ru/tsifrovye_tekhnologii_rm/rm-desktop/releases"
      }
    ],
    "mac": {
      "asarUnpack": [
        "dist-electron/native-addon.node",
        "node_modules/node-global-key-listener/bin/*.node",
        "**/*.node"
      ],
      "target": "mas",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/macEntitlements.plist",
      "provisioningProfile": "build/Storermelectron.provisionprofile",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "notarize": true,
      "identity": "Yuriy Tereshchenko (U95EM6ZJRW)",
      "type": "distribution",
      "x64ArchFiles": "**/dist-electron/native-addon.node"
    },
    "linux": {
      "category": "Chat;GNOME;GTK;Network;InstantMessaging",
      "icon": "build/icon",
      "description": "RM Desktop Client for Linux",
      "target": [
        "deb",
        "tar.xz",
        "AppImage",
        "snap"
      ],
      "maintainer": "Akash Nimare <akash@zulip.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageCategory": "net",
      "synopsis": "RM Desktop App",
      "afterInstall": "./packaging/deb-after-install.sh",
      "fpm": [
        "./packaging/deb-apt.list=/etc/apt/sources.list.d/zulip-desktop.list",
        "./packaging/deb-apt.asc=/etc/apt/trusted.gpg.d/zulip-desktop.asc",
        "./packaging/deb-release-upgrades.cfg=/etc/update-manager/release-upgrades.d/zulip-desktop.cfg"
      ]
    },
    "snap": {
      "synopsis": "RM Desktop App"
    },
    "dmg": {
      "background": "build/dmg-background.icns",
      "icon": "build/dmg-icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "ООО Цифровые Технологии Рм",
      "sign": "scripts/sign.js"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Связь РМ",
      "installerIcon": "build/installer-icon.ico"
    }
  },
  "keywords": [
    "RM",
    "Group Chat app",
    "electron-app",
    "electron",
    "Desktop app",
    "InstantMessaging"
  ],
  "dependencies": {
    "@electron/rebuild": "^4.0.1",
    "@jitsi/electron-sdk": "^7.0.9",
    "@jitsi/js-utils": "^2.4.6",
    "node-global-key-listener": "^0.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron/remote": "^2.0.8",
    "@sentry/core": "^8.26.0",
    "@sentry/electron": "^5.3.0",
    "@types/adm-zip": "^0.5.0",
    "@types/auto-launch": "^5.0.2",
    "@types/backoff": "^2.5.2",
    "@types/i18n": "^0.13.1",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.5",
    "@types/requestidlecallback": "^0.3.4",
    "@types/semver": "^7.5.8",
    "@types/yaireo__tagify": "^4.3.2",
    "@yaireo/tagify": "^4.5.0",
    "adm-zip": "^0.5.5",
    "auto-launch": "^5.0.5",
    "backoff": "^2.5.0",
    "electron": "^37.3.1",
    "electron-builder": "^24.6.4",
    "electron-log": "^5.3.3",
    "electron-notarize": "^1.2.2",
    "electron-updater": "^6.3.4",
    "electron-window-state": "^5.0.3",
    "escape-goat": "^4.0.0",
    "htmlhint": "^1.1.2",
    "i18n": "^0.15.1",
    "i18next-scanner": "^4.6.0",
    "medium": "^1.2.0",
    "node-json-db": "^1.3.0",
    "node-loader": "^2.1.0",
    "pg": "^8.16.3",
    "playwright-core": "^1.41.0-alpha-jan-9-2024",
    "pre-commit": "^1.2.2",
    "prettier": "^3.0.3",
    "semver": "^7.3.5",
    "stylelint": "^16.1.0",
    "stylelint-config-standard": "^36.0.0",
    "tape": "^5.2.2",
    "typescript": "^5.0.4",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.29.0",
    "xo": "^0.59.3",
    "zod": "^3.5.1"
  },
  "prettier": {
    "bracketSpacing": false,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "xo": {
    "prettier": true,
    "ignores": [
      "native-addon/**/*.js",
      "scripts/**/*.js",
      "afterpack.js",
      "app/main/trayManager.ts"
    ],
    "rules": {
      "@typescript-eslint/no-dynamic-delete": "off",
      "arrow-body-style": "error",
      "import/no-restricted-paths": [
        "error",
        {
          "zones": [
            {
              "target": "./app/common",
              "from": "./app",
              "except": [
                "./common"
              ]
            },
            {
              "target": "./app/main",
              "from": "./app",
              "except": [
                "./common",
                "./main"
              ]
            },
            {
              "target": "./app/renderer",
              "from": "./app",
              "except": [
                "./common",
                "./renderer",
                "./resources"
              ]
            }
          ]
        }
      ],
      "import/order": [
        "error",
        {
          "alphabetize": {
            "order": "asc"
          },
          "newlines-between": "always"
        }
      ],
      "import/unambiguous": "error",
      "no-restricted-imports": [
        "error",
        {
          "paths": [
            {
              "name": "@sentry/electron",
              "message": "Use @sentry/electron/main, @sentry/electron/renderer, or @sentry/core."
            },
            {
              "name": "electron",
              "message": "Use electron/main, electron/renderer, or electron/common."
            },
            {
              "name": "electron/main",
              "importNames": [
                "ipcMain"
              ],
              "message": "Use typed-ipc-main."
            },
            {
              "name": "electron/renderer",
              "importNames": [
                "ipcRenderer"
              ],
              "message": "Use typed-ipc-renderer."
            },
            {
              "name": "electron-log",
              "message": "Use electron-log/main or electron-log/renderer."
            }
          ]
        }
      ],
      "no-warning-comments": "off",
      "sort-imports": [
        "error",
        {
          "ignoreDeclarationSort": true
        }
      ],
      "strict": "error",
      "unicorn/prefer-module": "off",
      "unicorn/prefer-top-level-await": "off"
    },
    "envs": [
      "node",
      "browser"
    ],
    "overrides": [
      {
        "files": [
          "**/*.ts"
        ],
        "rules": {
          "@typescript-eslint/ban-types": "off",
          "@typescript-eslint/consistent-type-imports": [
            "error",
            {
              "disallowTypeAnnotations": false
            }
          ],
          "@typescript-eslint/no-unused-vars": [
            "error",
            {
              "argsIgnorePattern": "^_",
              "caughtErrors": "all"
            }
          ],
          "unicorn/no-await-expression-member": "off"
        }
      },
      {
        "files": [
          "i18next-scanner.config.js",
          "scripts/win-sign.js",
          "tests/**/*.js"
        ],
        "parserOptions": {
          "sourceType": "script"
        }
      },
      {
        "files": [
          "**/*.d.ts"
        ],
        "rules": {
          "import/unambiguous": "off"
        }
      }
    ]
  }
}
